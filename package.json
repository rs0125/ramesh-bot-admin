{
  "name": "@wareongo/bot-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "setup:local": "tsx scripts/setup-local.ts",
    "format": "prettier --write --ignore-unknown src tests scripts e2e .github *.ts *.json *.md docs",
    "format:check": "prettier --check --ignore-unknown src tests scripts e2e .github *.ts *.json *.md docs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.16 <23"
  }
}
